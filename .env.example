# Copy to .env.local for local development, and add the same variables in
# Vercel → Project → Settings → Environment Variables.

# Formspree form ID — the part after /f/ in https://formspree.io/f/xxxxxxx
NEXT_PUBLIC_FORMSPREE_ID=

# Public URL of the site (used for SEO, sitemap and Open Graph).
# Optional on Vercel: falls back to the production deployment URL.
NEXT_PUBLIC_SITE_URL=https://your-domain.com
